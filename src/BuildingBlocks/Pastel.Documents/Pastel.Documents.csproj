<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Pastel.Documents</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Pastel.SharedKernel/Pastel.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
