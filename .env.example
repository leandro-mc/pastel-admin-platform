# Local development values ONLY. Replace these before any deployment outside your machine.
# Default for local development; set Production explicitly to exercise production startup validation.
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=pastel
POSTGRES_USER=pastel
POSTGRES_PASSWORD=pastel_local_ChangeMe_82!

# PostgreSQL host port for pgAdmin on this machine only (127.0.0.1).
POSTGRES_PORT=5432

# At least 32 UTF-8 bytes. Generate a unique signing key for each environment.
JWT_SIGNING_KEY=LOCAL-ONLY_CHANGE_THIS_SIGNING_KEY_TO_A_RANDOM_SECRET_64_BYTES_2026!
JWT_SIGNING_KEY_ID=primary
# Optional previous key during rotation; configure the secret and ID together, then remove after old tokens expire.
JWT_PREVIOUS_SIGNING_KEY=
JWT_PREVIOUS_SIGNING_KEY_ID=
JWT_ACCESS_TOKEN_MINUTES=10
JWT_REFRESH_TOKEN_DAYS=7

# Created only if this email does not already exist. The first login forces a password change.
BOOTSTRAP_ADMIN_EMAIL=admin@pastel.local
BOOTSTRAP_ADMIN_PASSWORD=Pastel-Dev-Only-2026!

WEB_PORT=8080

# Módulos incluidos en backend y frontend. "*" = todos; lista separada por comas, p. ej. brisa,balance (Identity siempre).
PASTEL_MODULES=*

# URL pública con la que se abre la aplicación (con puerto en local). Debe coincidir con el redirect_uri registrado en Google.
APP_PUBLIC_BASE_URL=http://localhost:8080
# Hosts permitidos por la API (separados por ;). Ajuste en producción.
ALLOWED_HOSTS=localhost;127.0.0.1
# Subred(es) del proxy confiable (separadas por ;).
REVERSE_PROXY_TRUSTED_NETWORKS=172.30.0.0/24

# Acceso con correo y contraseña. El autorregistro con contraseña está desactivado por defecto.
AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_SELF_REGISTRATION_ENABLED=false

# Segundos para tolerar refresh concurrente con el mismo token (0 desactiva la gracia; 0–60).
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# Días que se conservan refresh tokens expirados antes de eliminarlos (30–3650).
EXPIRED_REFRESH_TOKEN_DAYS=30
# Días de retención de auditoría de Identity (30–3650).
AUDIT_LOG_RETENTION_DAYS=365
# Intervalo de limpieza de tokens y auditoría (1–168 horas).
IDENTITY_CLEANUP_INTERVAL_HOURS=24

# Google OAuth 2.0 (opcional). Guia paso a paso: docs/phase0/GOOGLE_OAUTH_SETUP.md
# Deje ambos vacios para desactivar el ingreso con Google. Nunca guarde aqui valores reales en el repositorio.
# El URI de redireccionamiento registrado en Google debe ser: APP_PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true permite crear una cuenta Member al ingresar por primera vez con Google; false solo admite cuentas existentes.
AUTH_GOOGLE_ALLOW_SIGNUP=true
