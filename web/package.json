{
  "name": "pastel-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/**/*.css\" \"vite.config.ts\" \"vite/**/*.ts\" \"eslint.config.js\" \"package.json\" \"package-lock.json\" \"tsconfig*.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/**/*.css\" \"vite.config.ts\" \"vite/**/*.ts\" \"eslint.config.js\" \"package.json\" \"package-lock.json\" \"tsconfig*.json\" \".prettierrc.json\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.4",
    "lucide-react": "^0.542.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
