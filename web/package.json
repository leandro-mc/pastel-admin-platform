{
  "name": "pastel-admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/styles.css\" \"vite.config.ts\" \"eslint.config.js\" \"package.json\" \"package-lock.json\" \"tsconfig*.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/styles.css\" \"vite.config.ts\" \"eslint.config.js\" \"package.json\" \"package-lock.json\" \"tsconfig*.json\" \".prettierrc.json\""
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "globals": "^16.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "prettier": "^3.6.2"
  }
}
